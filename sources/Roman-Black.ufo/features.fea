# Каждая фича зарегистрирована для всех languagesystem шрифта. Цифры и пунктуация — Common:
# шейпер берёт скрипт соседнего текста, и если такой скрипт есть в GSUB, запись DFLT не используется.
# locl не расширяется: его lookup27 подставляет болгарские формы и на cyrl dflt испортил бы русский.

feature ccmp {

 script DFLT;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup37;

 script armn;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup37;

 script bopo;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup37;

 script cyrl;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup37;
     language BGR  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup37;

 script grek;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup37;

 script latn;
     language dflt ;
      lookup ccmpGlyphCompositionDecompositionlookup37;
     language PLK  exclude_dflt;
      lookup ccmpGlyphCompositionDecompositionlookup37;
} ccmp;

